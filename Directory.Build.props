<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Godot runs the game from the editor in Debug: unoptimised, one aero evaluation takes 1-3 ms, and 2000 per
         simulated second (500 Hz, four RK4 evaluations) cannot keep up with real time. Symbols are kept. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
